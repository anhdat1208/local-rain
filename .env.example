# Local Rain — environment template
# Copy to .env and adjust if needed: cp .env.example .env

# PostgreSQL
POSTGRES_USER=localrain
POSTGRES_PASSWORD=localrain
POSTGRES_DB=localrain
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# API
API_HOST=0.0.0.0
API_PORT=8000
PUBLIC_API_BASE=http://localhost:8000
DATABASE_URL=postgresql+psycopg://localrain:localrain@postgres:5432/localrain
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000,http://web:3000

# Web (Nuxt)
NUXT_PUBLIC_API_BASE=http://localhost:8000
NUXT_HOST=0.0.0.0
NUXT_PORT=3000

# AI Assistant (server-side only — never expose to browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ASSISTANT_RATE_LIMIT=20
ASSISTANT_RATE_WINDOW=300
